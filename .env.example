# ---- Core ----
QAGENT_ENV=development
QAGENT_SECRET_KEY=change-me-in-production

# ---- Database ----
POSTGRES_USER=qagent
POSTGRES_PASSWORD=qagent
POSTGRES_DB=qagent
DATABASE_URL=postgresql+psycopg://qagent:qagent@postgres:5432/qagent

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- LLM provider ----
# Provider: anthropic | openai_compatible | null
# "null" uses the deterministic stub provider (no network, used by tests/CI).
QAGENT_LLM_PROVIDER=null
ANTHROPIC_API_KEY=
QAGENT_LLM_MODEL=claude-sonnet-5
# For Ollama / any OpenAI-compatible endpoint:
QAGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1

# ---- Budgets (per analysis run) ----
QAGENT_MAX_LLM_CALLS=40
QAGENT_MAX_LLM_TOKENS=200000
QAGENT_MAX_USD=2.00

# ---- Test runner sandbox ----
QAGENT_RUNNER_TIMEOUT_SECONDS=120
QAGENT_RUNNER_MAX_CONCURRENCY=4
QAGENT_EGRESS_ALLOWLIST=
