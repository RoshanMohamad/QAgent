# Bootstrap-only credentials: schema creation, application-role creation, and RLS
# policy installation (qagent/db_init.py). Copy to .env.admin; docker-compose.yml
# loads it only into the `api` container's startup command, never into `worker`
# -- see ADR-0007.
#
# This is POSTGRES_USER/POSTGRES_PASSWORD from .env: the official postgres image
# always makes POSTGRES_USER a superuser, and superusers bypass row-level
# security unconditionally, regardless of FORCE. DATABASE_URL in .env must be a
# different, unprivileged role - db_init creates it for you.
ADMIN_DATABASE_URL=postgresql+psycopg://qagent:qagent@postgres:5432/qagent
