# ---- Core ----
QAGENT_ENV=development
QAGENT_SECRET_KEY=change-me-in-production

# ---- Database ----
POSTGRES_USER=qagent
POSTGRES_PASSWORD=qagent
POSTGRES_DB=qagent
# Host ports. Change if something already owns the default.
POSTGRES_PORT=55432
REDIS_PORT=56379
# The API and worker connect as this role at runtime, never as POSTGRES_USER
# above. `qagent.db_init` creates it (from this DSN's own username/password)
# stripped of superuser/BYPASSRLS, so Postgres's row-level security actually
# governs its queries. See .env.admin.example and ADR-0007.
DATABASE_URL=postgresql+psycopg://qagent_app:qagent_app@postgres:5432/qagent

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- LLM provider ----
# Provider: anthropic | openai_compatible | null
# "null" uses the deterministic stub provider (no network, used by tests/CI).
QAGENT_LLM_PROVIDER=null
# Never put a real key in this file - it is tracked in git.
ANTHROPIC_API_KEY=
QAGENT_LLM_MODEL=claude-sonnet-5
# For Ollama / any OpenAI-compatible endpoint:
QAGENT_LLM_BASE_URL=

# ---- Budgets (per analysis run) ----
QAGENT_MAX_LLM_CALLS=40
QAGENT_MAX_LLM_TOKENS=200000
QAGENT_MAX_USD=2.00

# ---- Test runner sandbox ----
QAGENT_RUNNER_TIMEOUT_SECONDS=120
QAGENT_RUNNER_MAX_CONCURRENCY=4
QAGENT_EGRESS_ALLOWLIST=

# ---- Repository RAG (modules/rag/) ----
# Retrieval is BM25-only by default and needs no provider: on code, identifier
# overlap is a strong signal because what you search for appears verbatim in
# the code implementing it. Embeddings add the paraphrase cases.
QAGENT_EMBEDDING_PROVIDER=null
QAGENT_EMBEDDING_BASE_URL=
QAGENT_EMBEDDING_API_KEY=
QAGENT_EMBEDDING_MODEL=text-embedding-3-small
QAGENT_EMBEDDING_DIMENSIONS=1536
QAGENT_RAG_TOP_K=4
# json works on stock postgres:16-alpine (the image docker-compose runs) and
# searches in Python. pgvector needs `pip install qagent[rag]` AND the vector
# extension; db_init checks both and says so loudly if either is missing.
QAGENT_VECTOR_BACKEND=json

# ---- Evidence artifacts ----
# local | s3 (S3, Cloudflare R2, MinIO - needs `pip install qagent[s3]`).
# Both backends share one key layout, so migrating is a recursive copy.
QAGENT_STORAGE_BACKEND=local
QAGENT_ARTIFACT_ROOT=./data/artifacts
QAGENT_S3_BUCKET=
# Unset for AWS; set for R2/MinIO.
QAGENT_S3_ENDPOINT_URL=
QAGENT_S3_REGION=
# Leave unset on AWS so boto3's credential chain (env, shared config, instance
# role) applies - that is what a real deployment should use.
QAGENT_S3_ACCESS_KEY=
QAGENT_S3_SECRET_KEY=

# ---- Tracing (needs `pip install qagent[otel]`) ----
# Off by default and free when off: span() is a null context manager and
# nothing imports opentelemetry.
QAGENT_TRACING_ENABLED=false
QAGENT_TRACING_ENDPOINT=http://localhost:4318/v1/traces
QAGENT_TRACING_SERVICE_NAME=qagent
